<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd schedule for the LinkedIn scraper.

  Fires at several times/day (03:00 primary off-peak + daytime catch-ups). The
  --skip-if-recent guard in run_daily.sh makes this idempotent: only the first
  success each day does work; the rest no-op. This is what makes the pipeline run
  daily even when the overnight wake is suppressed (lid-closed on battery goes
  into standby and macOS skips the scheduled wake) — some fire-time will land
  while the Mac is awake during normal use.

  For the overnight 03:00 run to fire while asleep, also install the daily wake
  ONCE (works reliably on AC power):
    sudo ./scripts/setup_wake_schedule.sh      # pmset repeat wake @ 02:58

  Install: don't copy this by hand — run the installer, which renders the two
  /path/to/ds_jobs paths and the Label for this checkout, then (re)loads it:
    ./scripts/install_daily_trigger.sh
-->
<plist version="1.0">
<dict>

    <key>Label</key>
    <string>com.user.linkedin-scraper</string>

    <!-- No --sleep-after: daytime catch-up runs must not sleep an active Mac;
         after a run, normal idle-sleep takes over. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/ds_jobs/scripts/run_daily.sh</string>
        <string>--skip-if-recent</string>
    </array>

    <!-- Several fire-times/day; the --skip-if-recent guard keeps it to one run.
         03:00 is the off-peak primary (needs the pmset wake on battery); the
         daytime times catch up whenever the Mac is awake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/path/to/ds_jobs/logs/scrape.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/ds_jobs/logs/scrape.log</string>

</dict>
</plist>
